# Скопируйте этот файл в config.py и заполните своими значениями.
# На хостинге (Render/Railway/Fly) эти же значения задаются переменными
# окружения BOT_TOKEN / CHAT_ID / CHANNEL_ID — тогда config.py не нужен.

# Токен бота от @BotFather
BOT_TOKEN = "1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

# Чат, из которого берём ссылки (группа / чат). В нём бот срабатывает только
# когда его тегнут (@юзернейм со ссылкой) или реплайнули сообщение бота.
# ID вида -100XXXXXXXXXX. Как узнать: добавь бота в чат, напиши что-нибудь,
# затем запусти `python whoami.py <токен>` и посмотри chat.id.
CHAT_ID = "-1003743298448"

# Канал, куда публикуем пост по умолчанию. Для приватного канала — числовой ID
# вида -100XXXXXXXXXX (получается так же через whoami.py), для публичного — "@name".
CHANNEL_ID = "-1004447835579"

# Опционально: несколько пар «чат -> канал» одновременно. Если тегнуть бота
# в чате из маппинга, пост уйдёт в привязанный канал, иначе — в CHANNEL_ID.
# Формат строки: "чат:канал,чат:канал"
# CHAT_CHANNEL_MAP = "-1003743298448:-1004447835579,-100XXXXXXXXXX:-100YYYYYYYYYY"
