# Скопируйте этот файл в config.py и заполните своими значениями

# Токен бота от @BotFather
BOT_TOKEN = "1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

# ID канала, куда бот будет публиковать посты (по умолчанию).
# Для приватного канала — числовой ID вида -100XXXXXXXXXX. Проще всего получить:
# перешлите любое сообщение из канала боту в личку и посмотрите chat.id,
# либо используйте @userinfobot / метод getUpdates.
# Примеры вида: -1001234567890  или  "@gpc_test_chanel" (для публичного)
CHANNEL_ID = "-1001234567890"

# Привязка «чат -> канал» для нескольких каналов. Не обязательно: на хостинге
# удобнее задавать это переменной окружения CHAT_CHANNEL_MAP (см. DEPLOY.md).
# Формат: {"<id чата>": "<id канала>"}. Например, чат старого канала -> старый
# канал, чат нового приватного канала -> новый канал:
# CHAT_CHANNEL_MAP = {-1003743298448: -1001234567890, -100XXXXXXXXXX: -100YYYYYYYYYY}
